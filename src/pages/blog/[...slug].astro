---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { render } from 'astro:content';
import { getPublishedPosts, formatDate } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} — Tejas Mehta`} description={post.data.description}>
  <Nav />
  <main class="post">
    <div class="container">
      <a href="/blog" class="post-back">&larr; All posts</a>
      <article>
        <header class="post-header">
          <div class="post-meta">
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, true)}</time>
            {post.data.draft && <span class="tag tag-draft">Draft</span>}
            {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
          <h1>{post.data.title}</h1>
          <p class="post-lede">{post.data.description}</p>
        </header>
        <div class="prose">
          <Content />
        </div>
      </article>
    </div>
  </main>
  <Footer />
</Layout>

<style>
.post {
  padding-block: clamp(2rem, 5vw, 3rem) var(--section-pad);
}

.post .container {
  max-width: 760px;
}

.post-back {
  display: inline-block;
  font-family: var(--font-display);
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-text);
  padding: 0.5em 0.9em;
  background-color: var(--color-surface);
  border: var(--bw-sm) solid var(--brutal-border);
  box-shadow: 3px 3px 0 var(--brutal-shadow);
  margin-bottom: 2.5rem;
  transition: box-shadow 0.15s, transform 0.15s, background-color 0.15s, color 0.15s;
}

.post-back:hover {
  background-color: var(--color-text);
  color: var(--color-text-invert);
  box-shadow: 1px 1px 0 var(--brutal-shadow);
  transform: translate(2px, 2px);
}

.post-header {
  padding-bottom: 2rem;
  margin-bottom: 2.5rem;
  border-bottom: var(--bw) solid var(--brutal-border);
}

.post-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.6rem;
  font-family: var(--font-mono);
  font-size: 0.76rem;
  color: var(--color-text-muted);
  margin-bottom: 1.1rem;
}

.post-header h1 {
  font-size: clamp(2rem, 1.5rem + 1.9vw, 3rem);
  margin-bottom: 1rem;
}

.post-lede {
  font-size: 1.12rem;
  color: var(--color-text-muted);
  line-height: 1.65;
}
</style>

<style is:global>
.prose {
  font-size: 1.02rem;
  line-height: 1.75;
  color: var(--color-text);
}

.prose > * + * {
  margin-top: 1.25rem;
}

.prose h2 {
  font-size: 1.6rem;
  margin-top: 2.75rem;
  margin-bottom: 0.5rem;
  padding-bottom: 0.4rem;
  border-bottom: var(--bw-sm) solid var(--brutal-border);
}

.prose h3 {
  font-size: 1.2rem;
  margin-top: 2rem;
}

.prose p,
.prose li {
  color: var(--color-text);
}

.prose ul,
.prose ol {
  padding-left: 1.4rem;
}

.prose li + li {
  margin-top: 0.4rem;
}

.prose li::marker {
  color: var(--color-accent);
}

.prose a {
  text-decoration: underline;
  text-underline-offset: 3px;
}

.prose code {
  font-family: var(--font-mono);
  font-size: 0.86em;
  background-color: var(--color-surface);
  border: 1px solid var(--brutal-border);
  padding: 0.1em 0.35em;
}

.prose pre {
  background-color: var(--color-text);
  color: var(--color-text-invert);
  padding: 1.25rem 1.4rem;
  border: var(--bw) solid var(--brutal-border);
  box-shadow: 6px 6px 0 var(--brutal-shadow);
  overflow-x: auto;
  font-size: 0.86rem;
  line-height: 1.6;
}

.prose pre code {
  background: none;
  border: none;
  padding: 0;
  font-size: inherit;
  color: inherit;
}

.prose blockquote {
  border-left: var(--bw) solid var(--color-accent);
  background-color: var(--color-bg-alt);
  padding: 0.9rem 1.1rem;
  color: var(--color-text-muted);
}

.prose img {
  border: var(--bw) solid var(--brutal-border);
  box-shadow: 6px 6px 0 var(--brutal-shadow);
}
</style>
