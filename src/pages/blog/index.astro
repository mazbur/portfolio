---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getPublishedPosts, formatDate } from '../../lib/posts';

const posts = await getPublishedPosts();
---

<Layout
  title="Blog — Tejas Mehta"
  description="Notes on DevOps, Azure, Terraform, and cloud infrastructure by Tejas Mehta."
>
  <Nav />
  <main class="blog-index">
    <div class="container">
      <header class="blog-index-head" data-animate>
        <p class="section-label">Writing</p>
        <h1>
          Notes from the<br />
          <span class="muted">pipeline.</span>
        </h1>
        <p class="lede blog-index-sub">
          On DevOps, Azure, Terraform, and the automation that keeps systems boring.
        </p>
      </header>
      <ul class="post-list" role="list">
        {posts.map((post, i) => (
          <li data-animate style={`transition-delay: ${i * 0.05}s`}>
            <a href={`/blog/${post.id}/`} class="post-row brutal brutal-press">
              <div class="post-row-main">
                <div class="post-row-meta">
                  <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                  {post.data.draft && <span class="tag tag-draft">Draft</span>}
                </div>
                <h2 class="post-row-title">{post.data.title}</h2>
                <p class="post-row-desc">{post.data.description}</p>
                <div class="post-row-tags">
                  {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
                </div>
              </div>
              <span class="post-row-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </main>
  <Footer />
</Layout>

<style>
.blog-index {
  padding-block: clamp(2.5rem, 6vw, 4rem) var(--section-pad);
}

.blog-index-head {
  margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
}

.blog-index-head h1 {
  margin-bottom: 1.1rem;
}

.blog-index-head .muted {
  color: var(--color-text-muted);
}

.blog-index-sub {
  max-width: 50ch;
}

.post-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.post-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
  padding: 1.6rem 1.5rem;
  color: var(--color-text);
}

.post-row:hover {
  color: var(--color-text);
}

.post-row:hover .post-row-title {
  color: var(--color-accent);
}

.post-row-meta {
  font-family: var(--font-mono);
  font-size: 0.74rem;
  color: var(--color-text-muted);
  margin-bottom: 0.5rem;
}

.post-row-title {
  font-size: clamp(1.15rem, 1.05rem + 0.4vw, 1.4rem);
  margin-bottom: 0.5rem;
}

.post-row-desc {
  font-size: 0.9rem;
  color: var(--color-text-muted);
  line-height: 1.6;
  margin-bottom: 0.9rem;
  max-width: 62ch;
}

.post-row-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}

.post-row-arrow {
  font-family: var(--font-display);
  font-size: 1.5rem;
  font-weight: 700;
  flex-shrink: 0;
}

@media (max-width: 560px) {
  .post-row-arrow { display: none; }
}
</style>
