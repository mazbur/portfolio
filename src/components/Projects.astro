---
import { site } from '../site';

const projects = [
  {
    title: 'Terraform Drift Detection',
    color: 'var(--c-coral)',
    description:
      'Python tool that polls Terraform state and compares it against live Azure resources, alerting on configuration drift before it becomes an incident. Cut drift incidents 70% and prevented two critical outages.',
    tags: ['Python', 'Terraform', 'Azure', 'Azure DevOps'],
    links: site.github ? [{ label: 'GitHub', href: `${site.github}/terraform-drift-detector` }] : [],
  },
  {
    title: 'Policy-as-Code Platform',
    color: 'var(--c-indigo)',
    description:
      'OPA/Rego policy library with a Gatekeeper admission controller enforcing enterprise compliance on AKS. Prevents 95% of policy violations at PR time and generates auditable compliance reports.',
    tags: ['OPA/Rego', 'Gatekeeper', 'Kubernetes', 'Azure DevOps'],
    links: [],
  },
  {
    title: 'This Portfolio',
    color: 'var(--c-teal)',
    description:
      'Static Astro site on a private S3 bucket behind CloudFront. Infrastructure fully described in Terraform; zero long-lived AWS keys thanks to GitHub Actions OIDC. Initial payload under 100 KB.',
    tags: ['Astro', 'Terraform', 'AWS', 'GitHub Actions'],
    links: [{ label: 'GitHub', href: site.repo }],
  },
];
---

<section id="projects" class="band">
  <div class="container">
    <div data-animate>
      <p class="section-label">Portfolio</p>
      <h2 class="section-heading">
        Things I've built.<br />
        <span class="muted">And why they mattered.</span>
      </h2>
    </div>
    <div class="projects-grid">
      {projects.map((project, i) => (
        <article class="project-card brutal brutal-press" data-animate style={`transition-delay: ${i * 0.07}s`}>
          <span class="project-bar" style={`background-color: ${project.color}`} aria-hidden="true"></span>
          <div class="project-inner">
            <h3 class="project-title">{project.title}</h3>
            <p class="project-desc">{project.description}</p>
            <div class="project-tags">
              {project.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
            {project.links.length > 0 && (
              <div class="project-links">
                {project.links.map(({ label, href }) => (
                  <a href={href} target="_blank" rel="noopener noreferrer" class="project-link">
                    {label} &rarr;
                  </a>
                ))}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.projects-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}

.project-card {
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* Flat color strip across the top of the card */
.project-bar {
  height: 0.7rem;
  border-bottom: var(--bw) solid var(--brutal-border);
}

.project-inner {
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
  padding: 1.5rem 1.4rem;
  flex: 1;
}

.project-title {
  font-size: 1.15rem;
}

.project-desc {
  font-size: 0.88rem;
  color: var(--color-text-muted);
  line-height: 1.6;
}

.project-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin-top: auto;
}

.project-links {
  display: flex;
  gap: 1rem;
  padding-top: 0.9rem;
  border-top: var(--bw-sm) solid var(--brutal-border);
}

.project-link {
  font-family: var(--font-display);
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: var(--color-text);
}

.project-link:hover {
  color: var(--color-accent);
}

@media (max-width: 1000px) {
  .projects-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 640px) {
  .projects-grid { grid-template-columns: 1fr; }
}
</style>
