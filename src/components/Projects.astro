---
const projects = [
  {
    title: 'Terraform Drift Detection Tool',
    description:
      'Python tool that polls Terraform state and compares it against live Azure resources, alerting on configuration drift before it becomes an incident. Reduced drift incidents 70% and prevented two critical outages.',
    tags: ['Python', 'Terraform', 'Azure', 'Azure DevOps'],
    links: [{ label: 'GitHub', href: 'https://github.com/YOUR_GITHUB/terraform-drift-detector' }],
  },
  {
    title: 'Policy-as-Code Platform',
    description:
      'OPA/Rego policy library with a Gatekeeper admission controller enforcing enterprise compliance on AKS. Prevents 95% of policy violations at PR time and generates auditable compliance reports.',
    tags: ['OPA/Rego', 'Gatekeeper', 'Kubernetes', 'Azure DevOps'],
    links: [],
  },
  {
    title: 'This Portfolio',
    description:
      'Minimal static site built with Astro, hosted on private S3 behind CloudFront. Infrastructure as code with Terraform; zero long-lived AWS keys via GitHub Actions OIDC. Initial payload under 100 KB.',
    tags: ['Astro', 'Terraform', 'AWS', 'GitHub Actions'],
    links: [{ label: 'GitHub', href: 'https://github.com/YOUR_GITHUB/portfolio' }],
  },
];
---

<section id="projects" class="section-alt">
  <div class="container">
    <div data-animate>
      <p class="section-label">Portfolio</p>
      <h2 class="section-heading">Projects &amp; Highlights</h2>
    </div>
    <div class="projects-grid">
      {projects.map((project, i) => (
        <article class="project-card card" data-animate style={`transition-delay: ${i * 0.07}s`}>
          <div class="project-body">
            <h3 class="project-title">{project.title}</h3>
            <p class="project-desc">{project.description}</p>
            <div class="project-tags">
              {project.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          </div>
          {project.links.length > 0 && (
            <div class="project-links">
              {project.links.map(({ label, href }) => (
                <a href={href} target="_blank" rel="noopener noreferrer" class="project-link">
                  {label} &rarr;
                </a>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.section-alt {
  padding-block: var(--section-pad);
  background-color: var(--color-bg-alt);
}

.projects-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
  gap: 1rem;
}

.project-card {
  padding: 1.6rem;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 1.1rem;
}

.project-body {
  display: flex;
  flex-direction: column;
  gap: 0.7rem;
}

.project-title {
  font-size: 1.05rem;
  font-weight: 600;
}

.project-desc {
  font-size: 0.9rem;
  color: var(--color-text-muted);
  line-height: 1.6;
}

.project-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.35rem;
}

.project-links {
  display: flex;
  gap: 1rem;
  padding-top: 0.9rem;
  border-top: 1px solid var(--color-border);
}

.project-link {
  font-size: 0.83rem;
  font-weight: 500;
  color: var(--color-accent);
  transition: color 0.15s;
}

.project-link:hover {
  color: var(--color-accent-hover);
}
</style>
