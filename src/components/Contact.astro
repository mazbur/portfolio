---
const email    = 'official.tejas27@outlook.com';
const github   = 'https://github.com/mazbur';
const linkedin = 'https://linkedin.com/in/YOUR_LINKEDIN'; // TODO: replace
---

<section id="contact" class="band band-alt">
  <div class="container">
    <div class="contact-block" data-animate>
      <div class="contact-left">
        <p class="contact-label">Contact</p>
        <h2 class="contact-title">
          Let's build<br />something solid.
        </h2>
      </div>
      <div class="contact-right">
        <p class="contact-blurb">
          Open to interesting problems — a role, a collaboration, or just a
          question about cloud infrastructure. My inbox is open.
        </p>
        <div class="contact-links">
          <a href={`mailto:${email}`} class="btn btn-contact-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="16" x="2" y="4"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            Email me
          </a>
          <a
            href={github}
            class="btn btn-contact-outline"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub profile (opens in new tab)"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            GitHub
          </a>
          <a
            href={linkedin}
            class="btn btn-contact-outline"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn profile (opens in new tab)"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            LinkedIn
          </a>
        </div>
        <p class="contact-email-raw">{email}</p>
      </div>
    </div>
  </div>
</section>

<style>
.contact-block {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: clamp(1.75rem, 4vw, 3.5rem);
  padding: clamp(1.75rem, 4vw, 3rem);
  background-color: var(--color-text);
  border: var(--bw) solid var(--brutal-border);
  box-shadow: 8px 8px 0 var(--color-accent);
}

.contact-label {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--color-text-invert);
  border: var(--bw-sm) solid var(--color-text-invert);
  padding: 0.3em 0.7em;
  margin-bottom: 1.1rem;
}

.contact-title {
  color: var(--color-text-invert);
  font-size: clamp(1.8rem, 1.3rem + 1.8vw, 2.8rem);
}

.contact-right {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 1.5rem;
}

.contact-blurb {
  color: #CFC7B8;
  line-height: 1.7;
  max-width: 46ch;
}

.contact-links {
  display: flex;
  flex-wrap: wrap;
  gap: 0.85rem;
}

/* Buttons sit on a dark field — invert their borders and shadows. */
.btn-contact-primary,
.btn-contact-outline {
  border-color: var(--color-text-invert);
  box-shadow: 4px 4px 0 var(--color-accent);
}

.btn-contact-primary {
  background-color: var(--color-text-invert);
  color: var(--color-text);
}

.btn-contact-primary:hover {
  background-color: var(--color-accent);
  color: #fff;
}

.btn-contact-outline {
  background-color: transparent;
  color: var(--color-text-invert);
}

.btn-contact-outline:hover {
  background-color: var(--color-text-invert);
  color: var(--color-text);
}

.contact-email-raw {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  color: #A79E8E;
}

@media (max-width: 800px) {
  .contact-block { grid-template-columns: 1fr; }
}
</style>
