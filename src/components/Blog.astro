---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' });
---

<section id="blog" class="section-alt">
  <div class="container">
    <div class="blog-head" data-animate>
      <div>
        <p class="section-label">Writing</p>
        <h2 class="section-heading">From the blog</h2>
      </div>
      <a href="/blog" class="blog-all">All posts &rarr;</a>
    </div>
    <ul class="blog-list" role="list">
      {posts.map((post, i) => (
        <li data-animate style={`transition-delay: ${i * 0.06}s`}>
          <a href={`/blog/${post.id}/`} class="blog-item card">
            <div class="blog-meta">
              <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
              {post.data.tags[0] && <span class="blog-tag">{post.data.tags[0]}</span>}
            </div>
            <h3 class="blog-title">{post.data.title}</h3>
            <p class="blog-desc">{post.data.description}</p>
            <span class="blog-read">Read post &rarr;</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
.section-alt {
  padding-block: var(--section-pad);
  background-color: var(--color-bg-alt);
}

.blog-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
}

.blog-all {
  font-size: 0.9rem;
  font-weight: 500;
  margin-bottom: 2.25rem;
  white-space: nowrap;
}

.blog-list {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 1rem;
}

.blog-item {
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
  padding: 1.5rem;
  height: 100%;
  color: inherit;
}

.blog-item:hover {
  color: inherit;
}

.blog-meta {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  font-size: 0.78rem;
  color: var(--color-text-muted);
}

.blog-tag {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  color: var(--color-accent);
  padding: 0.15em 0.5em;
  border: 1px solid var(--color-border);
  border-radius: 5px;
}

.blog-title {
  font-size: 1.05rem;
  line-height: 1.3;
}

.blog-desc {
  font-size: 0.9rem;
  color: var(--color-text-muted);
  line-height: 1.6;
  flex: 1;
}

.blog-read {
  font-size: 0.83rem;
  font-weight: 500;
  color: var(--color-accent);
  margin-top: 0.25rem;
}
</style>
