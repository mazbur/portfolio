---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' });
---

<section id="blog" class="band">
  <div class="container">
    <div class="blog-head">
      <div data-animate>
        <p class="section-label">Writing</p>
        <h2 class="section-heading">
          Notes from the<br />
          <span class="muted">pipeline.</span>
        </h2>
      </div>
      <a href="/blog" class="btn btn-outline blog-all" data-animate>All posts &rarr;</a>
    </div>
    <ul class="blog-list" role="list">
      {posts.map((post, i) => (
        <li data-animate style={`transition-delay: ${i * 0.06}s`}>
          <a href={`/blog/${post.id}/`} class="blog-item brutal brutal-press">
            <div class="blog-meta">
              <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
              {post.data.tags[0] && <span class="tag">{post.data.tags[0]}</span>}
            </div>
            <h3 class="blog-title">{post.data.title}</h3>
            <p class="blog-desc">{post.data.description}</p>
            <span class="blog-read">Read post &rarr;</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
.blog-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1.5rem;
  flex-wrap: wrap;
}

.blog-head .section-heading {
  margin-bottom: 2.5rem;
}

.blog-all {
  margin-top: 0.25rem;
}

.blog-list {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}

.blog-item {
  display: flex;
  flex-direction: column;
  gap: 0.7rem;
  padding: 1.5rem 1.4rem;
  height: 100%;
  color: var(--color-text);
}

.blog-item:hover {
  color: var(--color-text);
}

.blog-meta {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  font-family: var(--font-mono);
  font-size: 0.74rem;
  color: var(--color-text-muted);
}

.blog-title {
  font-size: 1.1rem;
  line-height: 1.25;
}

.blog-item:hover .blog-title {
  color: var(--color-accent);
}

.blog-desc {
  font-size: 0.88rem;
  color: var(--color-text-muted);
  line-height: 1.6;
  flex: 1;
}

.blog-read {
  font-family: var(--font-display);
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  padding-top: 0.9rem;
  border-top: var(--bw-sm) solid var(--brutal-border);
}

@media (max-width: 1000px) {
  .blog-list { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 640px) {
  .blog-list { grid-template-columns: 1fr; }
}
</style>
