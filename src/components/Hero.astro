---
---

<section id="home" class="hero">
  <div class="container">
    <div class="hero-content" data-animate>
      <p class="hero-eyebrow">
        <span class="hero-status" aria-hidden="true"></span>
        DevOps Engineer · Azure · IaC
      </p>
      <h1 class="hero-name">Tejas Mehta</h1>
      <p class="hero-tagline">
        I build resilient, automated cloud infrastructure. 3+ years on Azure —
        cutting release cycles by <strong>45%</strong>, shrinking environment
        provisioning from <strong>4 days to 2 hours</strong>, and running AKS at
        <strong>99% deployment success</strong>.
      </p>
      <div class="hero-links">
        <a href="mailto:official.tejas27@outlook.com" class="btn btn-primary">
          Get in Touch
        </a>
        <a
          href="https://github.com/YOUR_GITHUB"
          class="btn btn-outline"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub profile (opens in new tab)"
        >GitHub</a>
        <a
          href="https://linkedin.com/in/YOUR_LINKEDIN"
          class="btn btn-outline"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn profile (opens in new tab)"
        >LinkedIn</a>
        <a
          href="/resume.pdf"
          class="btn btn-outline"
          download
          aria-label="Download resume as PDF"
        >Resume &darr;</a>
      </div>
    </div>
  </div>
</section>

<style>
.hero {
  padding-block: clamp(3rem, 7vw, 5rem) var(--section-pad);
}

.hero-content {
  max-width: 640px;
}

.hero-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 0.55rem;
  font-family: var(--font-mono);
  font-size: 0.8rem;
  color: var(--color-text-muted);
  margin-bottom: 1.5rem;
  padding: 0.35em 0.8em;
  border: 1px solid var(--color-border);
  border-radius: 999px;
  background-color: var(--color-surface);
}

.hero-status {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: #5F7A6B;
  box-shadow: 0 0 0 3px rgba(95, 122, 107, 0.2);
}

.hero-name {
  font-size: clamp(2.75rem, 2rem + 3.5vw, 4.5rem);
  letter-spacing: -0.035em;
  margin-bottom: 1.25rem;
}

.hero-tagline {
  font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
  color: var(--color-text-muted);
  max-width: 560px;
  margin-bottom: 2.25rem;
  line-height: 1.7;
}

.hero-tagline strong {
  color: var(--color-text);
  font-weight: 600;
}

.hero-links {
  display: flex;
  flex-wrap: wrap;
  gap: 0.65rem;
}
</style>
