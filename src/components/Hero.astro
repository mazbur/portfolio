---
import { site } from '../site';

const metrics = [
  { value: '45%',  label: 'Faster release cycles',  color: 'var(--c-coral)'  },
  { value: '99%',  label: 'AKS deploy success',     color: 'var(--c-teal)'   },
  { value: '2 hrs', label: 'To provision an env',   color: 'var(--c-indigo)' },
  { value: '70%',  label: 'Fewer drift incidents',  color: 'var(--c-amber)'  },
];
---

<section id="home" class="hero band">
  <div class="container hero-grid">
    <div class="hero-content" data-animate>
      <p class="hero-eyebrow">
        <span class="hero-status" aria-hidden="true"></span>
        Available for work
      </p>
      <h1 class="hero-title">
        Infrastructure<br />
        <span class="hero-title-accent">as code.</span><br />
        Deploys as routine.
      </h1>
      <p class="lede hero-lede">
        I'm Tejas Mehta — a DevOps engineer with 3+ years on Azure, building
        CI/CD pipelines, Terraform modules, and AKS platforms that teams can
        actually trust.
      </p>
      <div class="hero-links">
        <a href={`mailto:${site.email}`} class="btn btn-primary">
          Get in touch
        </a>
        <a
          href={site.resume}
          class="btn btn-outline"
          download
          aria-label="Download resume as PDF"
        >Resume &darr;</a>
      </div>
    </div>

    <div class="hero-panel brutal" data-animate>
      <div class="hero-panel-bar">
        <span class="hero-panel-title">impact.tf</span>
        <span class="hero-panel-dots" aria-hidden="true">
          <i></i><i></i><i></i>
        </span>
      </div>
      <ul class="hero-metrics" role="list">
        {metrics.map((m) => (
          <li class="hero-metric">
            <span class="hero-metric-bar" style={`background-color: ${m.color}`} aria-hidden="true"></span>
            <div>
              <p class="hero-metric-value">{m.value}</p>
              <p class="hero-metric-label">{m.label}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
.hero {
  padding-block: clamp(3rem, 6vw, 4.5rem) var(--section-pad);
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: clamp(2rem, 5vw, 4rem);
  align-items: center;
}

/* ---------- left ---------- */

.hero-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--font-mono);
  font-size: 0.72rem;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-text);
  margin-bottom: 1.5rem;
  padding: 0.35em 0.75em;
  background-color: var(--color-surface);
  border: var(--bw-sm) solid var(--brutal-border);
}

.hero-status {
  width: 8px;
  height: 8px;
  background-color: var(--c-lime);
  border: 1px solid var(--brutal-border);
}

.hero-title {
  font-size: clamp(2.5rem, 1.6rem + 4vw, 4.4rem);
  letter-spacing: -0.035em;
  margin-bottom: 1.4rem;
}

.hero-title-accent {
  color: var(--color-accent);
}

.hero-lede {
  margin-bottom: 2.25rem;
}

.hero-links {
  display: flex;
  flex-wrap: wrap;
  gap: 0.85rem;
}

/* ---------- right: metrics panel ---------- */

.hero-panel {
  box-shadow: 8px 8px 0 var(--brutal-shadow);
}

.hero-panel-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 2.85rem;
  padding-inline: 0.9rem;
  background-color: var(--color-text);
  border-bottom: var(--bw) solid var(--brutal-border);
}

.hero-panel-title {
  font-family: var(--font-mono);
  font-size: 0.76rem;
  color: var(--color-text-invert);
}

.hero-panel-dots {
  display: flex;
  gap: 0.35rem;
}

.hero-panel-dots i {
  width: 9px;
  height: 9px;
  background-color: var(--color-text-invert);
  opacity: 0.55;
}

.hero-metrics {
  list-style: none;
}

.hero-metric {
  display: flex;
  align-items: center;
  gap: 0.9rem;
  padding: 0.9rem 1.1rem;
}

.hero-metric + .hero-metric {
  border-top: var(--bw-sm) solid var(--brutal-border);
}

.hero-metric-bar {
  width: 0.7rem;
  align-self: stretch;
  min-height: 2.4rem;
  border: var(--bw-sm) solid var(--brutal-border);
}

.hero-metric-value {
  font-family: var(--font-display);
  font-size: 1.5rem;
  font-weight: 700;
  line-height: 1.05;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
}

.hero-metric-label {
  font-size: 0.82rem;
  color: var(--color-text-muted);
  line-height: 1.35;
}

@media (max-width: 900px) {
  .hero-grid { grid-template-columns: 1fr; }
  .hero-panel { max-width: 30rem; }
}
</style>
