---
// TODO: Add year and paste your Credly verify URLs
const certifications = [
  {
    name: 'Azure Administrator Associate',
    level: 'AZ-104',
    year: '[Year]',
    issuer: 'Microsoft',
    color: 'var(--c-teal)',
    verifyUrl: '#',
  },
  {
    name: 'Azure Fundamentals',
    level: 'AZ-900',
    year: '[Year]',
    issuer: 'Microsoft',
    color: 'var(--c-indigo)',
    verifyUrl: '#',
  },
];
---

<section id="certifications" class="band band-alt">
  <div class="container">
    <div data-animate>
      <p class="section-label">Credentials</p>
      <h2 class="section-heading">
        Certified.<br />
        <span class="muted">Verifiable.</span>
      </h2>
    </div>
    <ul class="cert-grid" role="list">
      {certifications.map((cert, i) => (
        <li class="cert-card brutal brutal-press" data-animate style={`transition-delay: ${i * 0.06}s`}>
          <span class="brutal-chip cert-chip" style={`--chip-color: ${cert.color}`} aria-hidden="true">
            {cert.level.split('-')[1]}
          </span>
          <div class="cert-body">
            <p class="cert-issuer">{cert.issuer}</p>
            <h3 class="cert-name">{cert.name}</h3>
            <div class="cert-meta">
              <span class="tag">{cert.level}</span>
              <span class="cert-year">{cert.year}</span>
            </div>
          </div>
          <a
            href={cert.verifyUrl}
            class="cert-verify"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Verify ${cert.name} certificate`}
          >Verify &rarr;</a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
.cert-grid {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
  max-width: 46rem;
}

.cert-card {
  display: grid;
  grid-template-columns: auto 1fr;
  grid-template-areas:
    'chip body'
    'verify verify';
  align-items: start;
  gap: 1.1rem;
  padding: 1.5rem 1.4rem;
}

.cert-chip {
  grid-area: chip;
  font-size: 0.82rem;
  box-shadow: 3px 3px 0 var(--brutal-shadow);
}

.cert-body {
  grid-area: body;
}

.cert-issuer {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-text-muted);
}

.cert-name {
  font-size: 1.05rem;
  line-height: 1.25;
  margin-top: 0.3rem;
}

.cert-meta {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  margin-top: 0.75rem;
}

.cert-year {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  color: var(--color-text-muted);
  font-variant-numeric: tabular-nums;
}

.cert-verify {
  grid-area: verify;
  font-family: var(--font-display);
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: var(--color-text);
  padding-top: 0.9rem;
  border-top: var(--bw-sm) solid var(--brutal-border);
}

.cert-verify:hover {
  color: var(--color-accent);
}

@media (max-width: 640px) {
  .cert-grid { grid-template-columns: 1fr; }
}
</style>
