---
// `year` and `verifyUrl` are optional — leave them null until you have the
// Credly badge URL, and the corresponding UI simply won't render.
const certifications: {
  name: string;
  level: string;
  year: string | null;
  issuer: string;
  color: string;
  verifyUrl: string | null;
}[] = [
  { name: 'Azure Devops Expert',
    level: 'AZ-400',
    year: '2026',
    issuer: 'Microsoft',
    color: 'var(--c-violet)',
    verifyUrl: 'https://learn.microsoft.com/api/credentials/share/en-us/TejasMehta-1105/7974E79D5CBE2955?sharingId=884CD9AB1CFBEA19'
  },
  {
    name: 'Azure Administrator Associate',
    level: 'AZ-104',
    year: '2026',
    issuer: 'Microsoft',
    color: 'var(--c-teal)',
    verifyUrl: 'https://learn.microsoft.com/api/credentials/share/en-us/TejasMehta-1105/FC88E500CF05BBB2?sharingId=884CD9AB1CFBEA19',
  },
  {
    name: 'AWS Solutions Architect Associate',
    level: 'SAA-003',
    year: '2026',
    issuer: 'AWS',
    color: 'var(--c-indigo)',
    verifyUrl: 'http://credly.com/badges/2ca661b4-47f0-485f-9997-f2925969920d/public_url',
  },
];
---

<section id="certifications" class="band band-alt">
  <div class="container">
    <div data-animate>
      <p class="section-label">Credentials</p>
      <h2 class="section-heading">
        Certified.<br />
        <span class="muted">Verifiable.</span>
      </h2>
    </div>
    <ul class="cert-grid" role="list">
      {certifications.map((cert, i) => (
        <li class="cert-card brutal brutal-press" data-animate style={`transition-delay: ${i * 0.06}s`}>
          <span class="brutal-chip cert-chip" style={`--chip-color: ${cert.color}`} aria-hidden="true">
            {cert.level.split('-')[1]}
          </span>
          <div class="cert-body">
            <p class="cert-issuer">{cert.issuer}</p>
            <h3 class="cert-name">{cert.name}</h3>
            <div class="cert-meta">
              <span class="tag">{cert.level}</span>
              {cert.year && <span class="cert-year">{cert.year}</span>}
            </div>
          </div>
          {cert.verifyUrl && (
            <a
              href={cert.verifyUrl}
              class="cert-verify"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Verify ${cert.name} certificate`}
            >Verify &rarr;</a>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
.cert-grid {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
  gap: 1.5rem;
}

.cert-card {
  display: grid;
  grid-template-columns: auto 1fr;
  grid-template-areas:
    'chip body'
    'verify verify';
  /* Body row absorbs slack so the verify rule aligns across cards of
     differing title length. */
  grid-template-rows: 1fr auto;
  align-items: start;
  gap: 1.1rem;
  padding: 1.5rem 1.4rem;
}

.cert-chip {
  grid-area: chip;
  font-size: 0.82rem;
  box-shadow: 3px 3px 0 var(--brutal-shadow);
}

.cert-body {
  grid-area: body;
}

.cert-issuer {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-text-muted);
}

.cert-name {
  font-size: 1.05rem;
  line-height: 1.25;
  margin-top: 0.3rem;
}

.cert-meta {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  margin-top: 0.75rem;
}

.cert-year {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  color: var(--color-text-muted);
  font-variant-numeric: tabular-nums;
}

.cert-verify {
  grid-area: verify;
  font-family: var(--font-display);
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: var(--color-text);
  padding-top: 0.9rem;
  border-top: var(--bw-sm) solid var(--brutal-border);
}

.cert-verify:hover {
  color: var(--color-accent);
}

@media (max-width: 640px) {
  .cert-grid { grid-template-columns: 1fr; }
}
</style>
