---
// TODO: Add year and paste your Credly verify URLs
const certifications = [
  {
    name: 'Microsoft Azure Administrator Associate',
    level: 'AZ-104',
    year: '[Year]',
    issuer: 'Microsoft',
    verifyUrl: '#',
  },
  {
    name: 'Microsoft Azure Fundamentals',
    level: 'AZ-900',
    year: '[Year]',
    issuer: 'Microsoft',
    verifyUrl: '#',
  },
];
---

<section id="certifications" class="section">
  <div class="container">
    <div data-animate>
      <p class="section-label">Credentials</p>
      <h2 class="section-heading">Certifications</h2>
    </div>
    <ul class="cert-grid" role="list">
      {certifications.map((cert, i) => (
        <li class="cert-card card" data-animate style={`transition-delay: ${i * 0.06}s`}>
          <div class="cert-body">
            <p class="cert-issuer">{cert.issuer}</p>
            <h3 class="cert-name">{cert.name}</h3>
            <p class="cert-meta">
              <span class="tag">{cert.level}</span>
              <span class="cert-year">{cert.year}</span>
            </p>
          </div>
          <a
            href={cert.verifyUrl}
            class="cert-verify"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Verify ${cert.name} certificate`}
          >Verify &rarr;</a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
.section {
  padding-block: var(--section-pad);
}

.cert-grid {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 1rem;
}

.cert-card {
  padding: 1.4rem 1.6rem;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 1rem;
}

.cert-issuer {
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-accent);
}

.cert-name {
  font-size: 0.98rem;
  font-weight: 600;
  line-height: 1.3;
  margin-top: 0.35rem;
}

.cert-meta {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  margin-top: 0.6rem;
}

.cert-year {
  font-size: 0.8rem;
  color: var(--color-text-muted);
  font-variant-numeric: tabular-nums;
}

.cert-verify {
  font-size: 0.82rem;
  font-weight: 500;
  color: var(--color-text-muted);
  transition: color 0.15s;
  align-self: flex-start;
}

.cert-verify:hover {
  color: var(--color-accent);
}
</style>
